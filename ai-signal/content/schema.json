{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Signal publication format v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "publication",
    "stories",
    "signalMap",
    "weekly"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "publication": {
      "type": "object",
      "required": [
        "name",
        "subtitle",
        "edition",
        "mode",
        "updatedAt"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "subtitle": {
          "type": "string",
          "minLength": 1
        },
        "edition": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "demo",
            "live"
          ]
        },
        "updatedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "format": "date"
        }
      },
      "additionalProperties": false
    },
    "stories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "slug",
          "title",
          "summary",
          "topic",
          "category",
          "signal",
          "status",
          "featured",
          "publishedAt",
          "updatedAt",
          "author",
          "visual",
          "scenario",
          "facts",
          "changed",
          "whyItMatters",
          "technicalImpact",
          "businessImpact",
          "outlook",
          "uncertainties",
          "analysis",
          "sources",
          "sourceNote",
          "review"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "topic": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "enum": [
              "Models",
              "Agents",
              "Infrastructure",
              "Robotics",
              "Enterprise AI",
              "Security & Governance",
              "Research"
            ]
          },
          "signal": {
            "enum": [
              "Noise",
              "Interesting",
              "Important",
              "Structural Shift"
            ]
          },
          "status": {
            "enum": [
              "demo",
              "draft",
              "published"
            ]
          },
          "featured": {
            "type": "boolean"
          },
          "publishedAt": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "format": "date"
          },
          "updatedAt": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "format": "date"
          },
          "author": {
            "type": "string",
            "minLength": 1
          },
          "visual": {
            "type": "string",
            "minLength": 1
          },
          "scenario": {
            "type": "string",
            "minLength": 1
          },
          "facts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "text",
                "sourceIds",
                "verifiedAt"
              ],
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "sourceIds": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "verifiedAt": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                  "format": "date"
                }
              },
              "additionalProperties": false
            }
          },
          "changed": {
            "type": "string",
            "minLength": 1
          },
          "whyItMatters": {
            "type": "string",
            "minLength": 1
          },
          "technicalImpact": {
            "type": "string",
            "minLength": 1
          },
          "businessImpact": {
            "type": "string",
            "minLength": 1
          },
          "outlook": {
            "type": "string",
            "minLength": 1
          },
          "uncertainties": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "analysis": {
            "type": "string",
            "minLength": 1
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "title",
                "publisher",
                "url",
                "publishedAt",
                "accessedAt"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]+$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "publisher": {
                  "type": "string",
                  "minLength": 1
                },
                "url": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https://"
                },
                "publishedAt": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                      "format": "date"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "accessedAt": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                  "format": "date"
                }
              },
              "additionalProperties": false
            }
          },
          "sourceNote": {
            "type": "string",
            "minLength": 1
          },
          "review": {
            "type": "object",
            "required": [
              "status",
              "reviewer",
              "reviewedAt"
            ],
            "properties": {
              "status": {
                "enum": [
                  "demonstration",
                  "pending",
                  "approved"
                ]
              },
              "reviewer": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reviewedAt": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                    "format": "date"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "demo"
                }
              }
            },
            "then": {
              "properties": {
                "facts": {
                  "maxItems": 0
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "published"
                }
              }
            },
            "then": {
              "properties": {
                "facts": {
                  "minItems": 1
                },
                "sources": {
                  "minItems": 1
                },
                "review": {
                  "properties": {
                    "status": {
                      "const": "approved"
                    },
                    "reviewer": {
                      "type": "string",
                      "minLength": 1
                    },
                    "reviewedAt": {
                      "type": "string",
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                      "format": "date"
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    "signalMap": {
      "type": "object",
      "required": [
        "status",
        "asOf",
        "note",
        "items"
      ],
      "properties": {
        "status": {
          "enum": [
            "demo",
            "editorial"
          ]
        },
        "asOf": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "format": "date"
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "items": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {
            "type": "object",
            "required": [
              "area",
              "direction",
              "dimension",
              "rationale",
              "storyId"
            ],
            "properties": {
              "area": {
                "type": "string",
                "minLength": 1
              },
              "direction": {
                "enum": [
                  "up",
                  "up-strong",
                  "down",
                  "flat"
                ]
              },
              "dimension": {
                "type": "string",
                "minLength": 1
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              },
              "storyId": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "weekly": {
      "type": "object",
      "required": [
        "slug",
        "title",
        "date",
        "status",
        "intro",
        "theme",
        "storyIds",
        "watchNext",
        "closing"
      ],
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "format": "date"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "format": "date"
        },
        "status": {
          "enum": [
            "demo",
            "published"
          ]
        },
        "intro": {
          "type": "string",
          "minLength": 1
        },
        "theme": {
          "type": "string",
          "minLength": 1
        },
        "storyIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "watchNext": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "closing": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
